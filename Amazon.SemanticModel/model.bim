          {
            "name": "利润目标",
            "expression": "SUM('月度目标'[利润目标])",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "dd41112b-99e6-4758-ba3f-7afc32eae289"
          },
          {
            "name": "广告预算",
            "expression": "SUM('月度目标'[广告预算])",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "893071d7-abba-4619-8853-0b4518522669"
          },
          {
            "name": "销售额完成率",
            "expression": "DIVIDE([销售额],[销售额目标])",
            "formatString": "0.0%",
            "lineageTag": "185aea7b-a50e-4a65-8677-eac91f74927e"
          },
          {
            "name": "销售额差额",
            "expression": "[销售额]-[销售额目标]",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "a8d35702-8c21-4b7a-a83f-046958f2e49a"
          },
          {
            "name": "销量完成率",
            "expression": "DIVIDE([销量],[销量目标])",
            "formatString": "0.0%",
            "lineageTag": "3cff82cb-4898-462f-be5e-31ee3291fdf7"
          },
          {
            "name": "销量差额",
            "expression": "[销量]-[销量目标]",
            "formatString": "#,0",
            "lineageTag": "6fb0d7fe-e97c-4315-b72d-086014e2548b"
          },
          {
            "name": "利润完成率",
            "expression": "DIVIDE([经营贡献利润],[利润目标])",
            "formatString": "0.0%",
            "lineageTag": "3a031dd0-a920-43db-a577-c1bfd0cd4e8e"
          },
          {
            "name": "利润差额",
            "expression": "[经营贡献利润]-[利润目标]",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "543582b8-4abb-4c6a-9f02-3cbdf5be8a49"
          },
          {
            "name": "广告预算完成率",
            "expression": "DIVIDE([广告花费],[广告预算])",
            "formatString": "0.0%",
            "lineageTag": "1c7fa879-4a16-4d9e-b059-5e5473b5f739"
          },
          {
            "name": "广告预算差额",
            "expression": "[广告花费]-[广告预算]",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "293e47e2-de12-48a0-9aca-54bfe4b77615"
          },
          {
            "name": "目标状态",
            "expression": "IF([销售额完成率]>=1,\"达标\",\"未达标\")",
            "lineageTag": "facbab7d-dd3c-4c63-abe7-b209e1d19a64"
          },
          {
            "name": "库存成本金额",
            "expression": "SUMX('库存',('库存'[期末可售件数]+'库存'[预留件数])*(RELATED('商品'[采购美元])+RELATED('商品'[头程美元])))",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "4494ea1f-8181-4560-98d9-1b61709a2315"
          },
          {
            "name": "平均库存成本",
            "expression": "AVERAGEX(VALUES('日期'[日期]),[库存成本金额])",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "604a9512-6caa-4f88-acbf-a479b587e8f0"
          },
          {
            "name": "销售净成本",
            "expression": "-CALCULATE([财务科目金额],'财务'[科目] IN {\"商品成本\",\"退回商品成本转回\"})",
            "formatString": "\"$\"#,0.00",
            "lineageTag": "90adca8c-f41b-4878-80c0-4d41ebe72955"
          },
          {
            "name": "库存周转天数",
            "expression": "DIVIDE([平均库存成本],[销售净成本])*COUNTROWS(VALUES('日期'[日期]))",
            "formatString": "0.0",
            "lineageTag": "a2e53051-151d-4395-87ed-36e31322964c"
          },
          {
            "name": "30天无销量库存",
            "expression": "VAR d=MAX('日期'[日期]) VAR firstDay=CALCULATE(MIN('日期'[日期]),REMOVEFILTERS('日期')) RETURN IF(d-firstDay+1<30 || ISBLANK([期末可售库存]),BLANK(),COALESCE(SUMX(FILTER(VALUES('商品'[SKU]),NOT ISBLANK([近30天销量]) && [近30天销量]=0),[期末可售库存]),0))",
            "formatString": "#,0",
            "lineageTag": "37dbd4dd-6b95-45d6-9d9b-70e87cd26219"
          },
          {
            "name": "30天无销量库存显示",
            "expression": "IF(ISBLANK([期末可售库存]),\"无库存数据\",IF(ISBLANK([近30天销量]),\"历史不足30天\",FORMAT([30天无销量库存],\"#,0\")))",
            "lineageTag": "e226b67b-d928-4490-b524-6903da178c67"
          }
        ],
        "partitions": [
          {
            "name": "日期",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " Source = Csv.Document(File.Contents(\"__DATA_DIR__/00_日期.csv\"),[Delimiter=\",\",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed = Table.TransformColumnTypes(Headers,{{\"日期\", type date},{\"年\", Int64.Type},{\"月\", Int64.Type},{\"年月\", type text},{\"星期\", Int64.Type}},\"en-US\")",
                "in Typed"
              ],
              "type": "m"
            }
          }
        ]
