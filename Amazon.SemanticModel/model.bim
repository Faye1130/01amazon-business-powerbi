          {
            "name": "搜索词点击",
            "expression": "SUM('搜索词'[点击])",
            "formatString": "#,0",
            "lineageTag": "a09f70bf-1e1f-4985-9f6b-817a47493585"
          },
          {
            "name": "搜索词ACOS",
            "expression": "DIVIDE([搜索词花费],[搜索词销售额])",
            "formatString": "0.0%",
            "lineageTag": "a437f6d0-c072-4445-a4c8-c1923e881a5f"
          },
          {
            "name": "搜索词出单率",
            "expression": "DIVIDE(COUNTROWS(FILTER(VALUES('搜索词'[搜索词]),[搜索词订单]>0)),COUNTROWS(FILTER(VALUES('搜索词'[搜索词]),[搜索词点击]>0)))",
            "formatString": "0.0%",
            "lineageTag": "b9071dc2-cc2d-4c5f-9d23-cf483b31ee05"
