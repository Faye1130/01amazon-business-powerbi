	measure 近7天销量 = VAR d=MAX('日期'[日期]) VAR firstDay=CALCULATE(MIN('日期'[日期]),REMOVEFILTERS('日期')) RETURN IF(d-firstDay+1>=7,CALCULATE([销量],REMOVEFILTERS('日期'),'日期'[日期]>d-7,'日期'[日期]<=d))
