	measure 销售额上期 = VAR oneMonth=HASONEVALUE('日期'[年月]) VAR d=MAX('日期'[日期]) VAR prevStart=EOMONTH(d,-2)+1 VAR prevEnd=EOMONTH(d,-1) VAR firstDay=CALCULATE(MIN('日期'[日期]),REMOVEFILTERS('日期')) RETURN IF(oneMonth && prevStart>=firstDay,CALCULATE([销售额],REMOVEFILTERS('日期'),'日期'[日期]>=prevStart,'日期'[日期]<=prevEnd))
