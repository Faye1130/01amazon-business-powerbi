		lineageTag: facbab7d-dd3c-4c63-abe7-b209e1d19a64

	measure 库存成本金额 = SUMX('库存',('库存'[期末可售件数]+'库存'[预留件数])*(RELATED('商品'[采购美元])+RELATED('商品'[头程美元])))
		formatString: "$"#,0.00
		lineageTag: 4494ea1f-8181-4560-98d9-1b61709a2315

	measure 平均库存成本 = AVERAGEX(VALUES('日期'[日期]),[库存成本金额])
		formatString: "$"#,0.00
		lineageTag: 604a9512-6caa-4f88-acbf-a479b587e8f0

	measure 销售净成本 = -CALCULATE([财务科目金额],'财务'[科目] IN {"商品成本","退回商品成本转回"})
		formatString: "$"#,0.00
		lineageTag: 90adca8c-f41b-4878-80c0-4d41ebe72955

	measure 库存周转天数 = DIVIDE([平均库存成本],[销售净成本])*COUNTROWS(VALUES('日期'[日期]))
		formatString: 0.0
		lineageTag: a2e53051-151d-4395-87ed-36e31322964c

	measure 30天无销量库存 = VAR d=MAX('日期'[日期]) VAR firstDay=CALCULATE(MIN('日期'[日期]),REMOVEFILTERS('日期')) RETURN IF(d-firstDay+1<30 || ISBLANK([期末可售库存]),BLANK(),COALESCE(SUMX(FILTER(VALUES('商品'[SKU]),NOT ISBLANK([近30天销量]) && [近30天销量]=0),[期末可售库存]),0))
		formatString: #,0
		lineageTag: 37dbd4dd-6b95-45d6-9d9b-70e87cd26219

	measure 30天无销量库存显示 = IF(ISBLANK([期末可售库存]),"无库存数据",IF(ISBLANK([近30天销量]),"历史不足30天",FORMAT([30天无销量库存],"#,0")))
		lineageTag: e226b67b-d928-4490-b524-6903da178c67

